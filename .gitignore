# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ─── Firebase / Secret configuration ──────────────────────────────────────────
# These files contain API keys and must NEVER be committed.
# Each developer/CI pipeline should obtain them from a secure secret store.
.env
.env.*
!.env.example

# Firebase SDK config files (contain project API keys)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Android signing / local machine configuration
/android/local.properties
/android/key.properties

# Firebase service account JSON (server-side admin credentials)
*serviceAccount*.json
*service-account*.json

# ─── Android build artefacts ──────────────────────────────────────────────────
# Crash dumps / profiling files
*.hprof
android/hs_err_pid*.log
android/java_pid*.hprof

# ─── Node / Firebase Functions ────────────────────────────────────────────────
functions/node_modules/

# ─── Temporary files ──────────────────────────────────────────────────────────
*.tmp
*.bak
firebase-debug.log
firebase-debug.*.log
.firebase/
