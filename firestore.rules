rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── admins ────────────────────────────────────────────────────────────────
    // Read: any authenticated user may read their own admin document.
    // Write: only server-side (Cloud Functions via Admin SDK) or existing admins.
    match /admins/{adminId} {
      allow read: if request.auth != null
                  && request.auth.token.email == resource.data.email;
      allow write: if false; // Managed by Admin SDK / Cloud Functions only.
    }

    // ── pin_rate_limits ───────────────────────────────────────────────────────
    // These documents are written exclusively by the verifyPin Cloud Function
    // (which uses the Admin SDK and bypasses these rules). Client access is
    // intentionally denied to prevent tampering.
    match /pin_rate_limits/{uid} {
      allow read, write: if false;
    }

    // ── Default deny-all ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
